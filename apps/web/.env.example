# Copie para .env.local. Com o Supabase local (supabase start), os valores aparecem em `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional: permite convidar pessoas por e-mail na tela Usuários. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
